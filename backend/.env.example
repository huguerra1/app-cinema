# Copie para backend/.env para rodar o backend fora do Docker.
DATABASE_URL=postgresql://user:password@localhost:5432/cinema_db?schema=public
JWT_SECRET=
# Sem ambas as variáveis, o seed cria somente os perfis USER e ADMIN.
# Use um email exclusivo. Reexecuções não alteram contas nem senhas existentes.
ADMIN_EMAIL=
ADMIN_PASSWORD=
